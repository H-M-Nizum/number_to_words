<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="number_to_words_rule_view_list" model="ir.ui.view">
        <field name="name">number.to.words.rule.list</field>
        <field name="model">number.to.words.rule</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="target"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="number_to_words_rule_view_form" model="ir.ui.view">
        <field name="name">number.to.words.rule.form</field>
        <field name="model">number.to.words.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="model_name" invisible="1"/>
                    <field name="form_field_names" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Amounts in words on quotations"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="target" widget="radio"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="base_view_id" options="{'no_create': True}"
                                   invisible="target != 'form'" required="target == 'form'"/>
                            <field name="report_name" invisible="1"/>
                            <field name="report_id" options="{'no_create': True}"
                                   invisible="target != 'report'" required="target == 'report'"/>
                            <field name="report_view_id" options="{'no_create': True}"
                                   invisible="target != 'report'" required="target == 'report'"
                                   readonly="not report_id"/>
                            <field name="record_var" invisible="target != 'report'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields" name="form_fields" invisible="target != 'form'">
                            <field name="form_line_ids" string="Field" nolabel="1" invisible="not model_id"
                                   context="{'default_target': 'form'}">
                                <list>
                                    <field name="target" column_invisible="True"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_id"/>
                                    <field name="mode"/>
                                    <field name="currency_field_id"/>
                                    <field name="language_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="anchor_field_id"/>
                                    <field name="position"/>
                                </list>
                                <form string="Form Field">
                                    <field name="target" invisible="1"/>
                                    <group>
                                        <group string="What to convert">
                                            <field name="field_id" options="{'no_create': True}"
                                                   domain="[('model_id', '=', parent.model_id), ('ttype', 'in', ['float', 'monetary', 'integer'])]"/>
                                            <field name="mode"/>
                                            <field name="currency_field_id" options="{'no_create': True}"
                                                   invisible="mode != 'currency'"
                                                   domain="[('model_id', '=', parent.model_id), ('ttype', '=', 'many2one'), ('relation', '=', 'res.currency')]"/>
                                            <field name="language_id" options="{'no_create': True, 'no_open': True}"/>
                                        </group>
                                        <group string="Where to show it">
                                            <field name="anchor_field_id" options="{'no_create': True}"
                                                   domain="[('model_id', '=', parent.model_id), ('name', 'in', parent.form_field_names)]"/>
                                            <field name="position"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Fields" name="report_fields" invisible="target != 'report'">
                            <div class="text-muted fst-italic mb-2" invisible="report_view_id">
                                Choose the report above first, then add the fields to show in words.
                            </div>
                            <field name="report_line_ids" string="Field" nolabel="1"
                                   invisible="not model_id or not report_view_id"
                                   context="{'default_target': 'report'}">
                                <list>
                                    <field name="target" column_invisible="True"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_id"/>
                                    <field name="mode"/>
                                    <field name="currency_field_id"/>
                                    <field name="language_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="report_anchor_id" string="Place Next To"/>
                                    <field name="xpath_expr" optional="hide" groups="base.group_no_one"/>
                                    <field name="position"/>
                                </list>
                                <form string="Report Field">
                                    <field name="target" invisible="1"/>
                                    <group>
                                        <group string="What to convert">
                                            <field name="field_id" options="{'no_create': True}"
                                                   domain="[('model_id', '=', parent.model_id), ('ttype', 'in', ['float', 'monetary', 'integer'])]"/>
                                            <field name="mode"/>
                                            <field name="currency_field_id" options="{'no_create': True}"
                                                   invisible="mode != 'currency'"
                                                   domain="[('model_id', '=', parent.model_id), ('ttype', '=', 'many2one'), ('relation', '=', 'res.currency')]"/>
                                            <field name="language_id" options="{'no_create': True, 'no_open': True}"/>
                                        </group>
                                        <group string="Where to show it">
                                            <field name="report_anchor_id" string="Place Next To" options="{'no_create': True, 'no_open': True}"
                                                   required="target == 'report'"
                                                   readonly="not parent.report_view_id"
                                                   placeholder="Choose a place in the report..."
                                                   context="{'ntw_view_id': parent.report_view_id, 'ntw_model': parent.model_name, 'ntw_var': parent.record_var}"
                                                   domain="[('view_id', '=', parent.report_view_id)]"/>
                                            <field name="xpath_expr" string="XPath (technical)" readonly="1"
                                                   groups="base.group_no_one"
                                                   invisible="not xpath_expr"/>
                                            <field name="position"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="number_to_words_rule_view_search" model="ir.ui.view">
        <field name="name">number.to.words.rule.search</field>
        <field name="model">number.to.words.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_form" string="Form view" domain="[('target', '=', 'form')]"/>
                <filter name="filter_report" string="PDF report" domain="[('target', '=', 'report')]"/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="number_to_words_rule_action" model="ir.actions.act_window">
        <field name="name">Display Rules</field>
        <field name="res_model">number.to.words.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="number_to_words_rule_view_search"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a display rule</p>
            <p>Pick a model, then add a line for each numeric field you want shown in words on its form view.</p>
        </field>
    </record>
</odoo>
