<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="number_to_words.NumberToWordsField">
        <div class="o_number_to_words d-flex flex-column">
            <t t-if="!props.wordsOnly">
            <span t-if="props.readonly" t-esc="formattedValue"/>
            <input t-else=""
                   t-on-focusin="onFocusIn"
                   t-on-focusout="onFocusOut"
                   t-att-id="props.id"
                   t-ref="numpadDecimal"
                   t-att-type="props.inputType"
                   inputmode="decimal"
                   class="o_input"
                   autocomplete="off"
                   t-att-step="props.step"/>
            </t>
            <small t-if="wordsState.text" class="o_number_to_words_text text-muted fst-italic" t-esc="wordsState.text"/>
        </div>
    </t>

</templates>
